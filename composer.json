{
    "name": "warksit/laravel-mail-chimp-sync",
    "description": "Sync Laravel Models with MailChimp as Members or Interests",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrew Westrope",
            "email": "andrew@warwickshire.it"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Warksit\\LaravelMailChimpSync\\": "src/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Warksit\\LaravelMailChimpSync\\Tests\\": "tests/",
            "App\\": "tests/stubs/App/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
