# Only the integration suite reads these. Use a test list: it creates and deletes
# an interest, and subscribes MAILCHIMP_TEST_EMAIL (MailChimp sends it an opt-in).
MAILCHIMP_ENDPOINT=https://us1.api.mailchimp.com
MAILCHIMP_API=
MAILCHIMP_LIST_ID=
MAILCHIMP_INTEREST_CATEGORY_ID=
MAILCHIMP_TEST_EMAIL=
